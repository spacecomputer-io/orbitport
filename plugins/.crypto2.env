### general vars ###

ORBITPORT_PLUGIN=crypto2
# ORBITPORT_GRPC_PORT=50001
# ORBITPORT_METRICS_PORT=9000

### plugin vars ###

# ORBITPORT_CRYPTO2_CLIENT_ID=your_client_id # required
# ORBITPORT_CRYPTO2_CLIENT_SECRET=your_client_secret # required

# ORBITPORT_CRYPTO2_API_URL=https://api.aptosorbital.com
# ORBITPORT_CRYPTO2_AUTH_URL=https://auth.aptosorbital.com/oauth2/token
# ORBITPORT_CRYPTO2_RATE_LIMIT=0.5
# Legacy `ORBITPORT_APTOS_ORBITAL_*` env names are still accepted.
