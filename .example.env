### required vars:

ORBITPORT_APTOS_ORBITAL_CLIENT_ID=your_client_id
ORBITPORT_APTOS_ORBITAL_CLIENT_SECRET=your_client_secret

ORBITPORT_IPFS_DATA_DIR=./.data/ipfs

### optional
# ORBITPORT_AUTH0_DOMAIN=your_auth0_domain
# ORBITPORT_AUTH0_AUDIENCE=your_auth0_audience
# dev.docker-compose uses a separate noop auth plugin and does not require auth bypass flags

### account plugin (optional — when set, gateway enforces credit Hold/Release
### against the dashboard backend on every JWT-authenticated request)
# ORBITPORT_ACCOUNT_DASHBOARD_URL=https://dashboard.example.com
# ORBITPORT_ACCOUNT_AUTH0_DOMAIN=your_auth0_domain
# ORBITPORT_ACCOUNT_AUTH0_AUDIENCE=https://dashboard-api.example.com
# ORBITPORT_ACCOUNT_AUTH0_CLIENT_ID=your_m2m_client_id
# ORBITPORT_ACCOUNT_AUTH0_CLIENT_SECRET=your_m2m_client_secret
# ORBITPORT_ACCOUNT_CREDITS_PER_UNIT=1
# ORBITPORT_ACCOUNT_HTTP_TIMEOUT_SECS=5

# ORBITPORT_DEFAULT_MASTER_SEEDS=""
# ORBITPORT_OPENBAO_ETH_PLUGIN_DIR=../openbao-eth-plugin
# ORBITPORT_OPENBAO_PQC_PLUGIN_DIR=../openbao-pqc-plugin
# ORBITPORT_OPENBAO_PQC_BACKEND=openssl
# ORBITPORT_OPENBAO_THRESHOLD_PLUGIN_DIR=../openbao-threshold-plugin
# ORBITPORT_THRESHOLD_ENABLED=false
# ORBITPORT_THRESHOLD_SESSION_SECRET=dev-threshold-session-secret
# ORBITPORT_THRESHOLD_RETRY_ATTEMPTS=3
# ORBITPORT_THRESHOLD_RETRY_BACKOFF_MILLIS=100
# ORBITPORT_THRESHOLD_GROUPS='{"e2e-group":{"threshold":2,"participants":[{"node_id":"node-a","party_index":0,"openbao_url":"http://openbao-proxy:8200","mount":"threshold"},{"node_id":"node-b","party_index":1,"openbao_url":"http://openbao-proxy-1:8200","mount":"threshold"},{"node_id":"node-c","party_index":2,"openbao_url":"http://openbao-proxy-2:8200","mount":"threshold"}]}}'

# ORBITPORT_IPFS_DATA_DIR=./.data/ipfs
# ORBITPORT_IPFS_ADDRESS=http://localhost:5001
### optional, see defaults:

# ORBITPORT_APTOS_ORBITAL_API_URL=https://api.aptosorbital.com
# ORBITPORT_APTOS_ORBITAL_AUTH_URL=https://auth.aptosorbital.com/oauth2/token
# ORBITPORT_APTOS_ORBITAL_RATE_LIMIT=0.1
