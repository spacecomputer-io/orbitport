### required vars:

STARGATE_APTOS_ORBITAL_CLIENT_ID=your_client_id
STARGATE_APTOS_ORBITAL_CLIENT_SECRET=your_client_secret

### the other vars are optional, see defaults:

# STARGATE_PORT=8080
# STARGATE_APTOS_ORBITAL_API_URL=https://api.aptosorbital.com
# STARGATE_APTOS_ORBITAL_AUTH_URL=https://auth.aptosorbital.com/oauth2/token
# STARGATE_APTOS_ORBITAL_RATE_LIMIT=0.1
